# Example .env for backend (DO NOT commit real credentials)
# Copy this file to backend/.env and fill real values for production.

# Express server mode: development / production / test / staging
NODE_ENV=development

# Express server port
PORT=3000

# Email account to send email from (SMTP user)
EMAIL_FROM_USER=your+from@example.com

# Email account password or app password (DO NOT commit)
EMAIL_FROM_PASSWORD=your_smtp_password_or_app_password

# Email service name (e.g. gmail, SendGrid)
EMAIL_SERVICE_NAME=gmail

# Default recipient (fallback)
EMAIL_TO_USER=recipient@example.com

# Optional: allowed recipient addresses (semicolon-separated)
# Example: your+recipient@example.com;other@example.com
EMAIL_RECIPIENTS=recipient@example.com;other@example.com

# Enable production email sending. In production set to true and provide real creds.
SERVER_LIVE=false

# FRONTEND_URL (semicolon-separated allowed origins) - useful for CORS
# Example: http://example.com;https://www.example.com
FRONTEND_URL=http://localhost:5173
